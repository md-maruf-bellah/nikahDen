# ------------------------------------------------------------------
# Nikah Deen backend — example environment (safe defaults for dev)
# কপি করে .env বানান:  cp .env.example .env
# ------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB — লোকাল বা Atlas (ট্রানজ্যাকশনের জন্য replica set/Atlas ভালো)
MONGODB_URI=mongodb://127.0.0.1:27017/nikahdeen_dev

# ফ্রন্টএন্ডের origin (CORS + OAuth callback রিডাইরেক্ট)
CLIENT_URL=http://localhost:3000

# JWT — প্রোডাকশনে অবশ্যই লম্বা র‍্যান্ডম মান (openssl rand -hex 48)
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# true করলে টোকেন httpOnly cookie-তেও যায় (JSON বডির পাশাপাশি)
USE_COOKIES=false

# ---- রেট লিমিট (optional, ডিফল্টই ভালো) ----
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=20
# OAUTH_RATE_LIMIT_MAX=10
# OAUTH_FAILURE_LIMIT=5
# OAUTH_FAILURE_WINDOW_MS=900000
# OAUTH_FAILURE_BLOCK_MS=900000

# ---- OAuth (না দিলে সংশ্লিষ্ট সোশ্যাল বাটন নিষ্ক্রিয় থাকে, ক্র্যাশ হয় না) ----
# Google Cloud Console → Credentials → OAuth client (Web application)
# Authorized redirect URI: http://localhost:5000/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook Developers → App → Settings → Basic
# Valid OAuth Redirect URI: http://localhost:5000/api/v1/auth/oauth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---- ইমেইল (forgot-password ইত্যাদি; খালি থাকলে ডেভে লিংক server log-এ) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Nikah Deen <no-reply@nikahdeen.local>
